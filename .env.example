# ===========================================
# PranaAI Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# -------------------------------------------
# Database Configuration
# -------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=prana_db
POSTGRES_PORT=5432

# Or use full DATABASE_URL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/prana_db

# -------------------------------------------
# Redis Configuration (Optional)
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here

# -------------------------------------------
# Security & Authentication
# -------------------------------------------
# IMPORTANT: Generate a secure random key for production!
# Use: openssl rand -hex 32
# Leave empty in development (a random key is generated per run; logins reset on restart).
# Required when ENVIRONMENT is not development.
SECRET_KEY=

# -------------------------------------------
# External API Keys (Optional but Recommended)
# -------------------------------------------
# OpenWeather API Key (for weather & air quality data)
# Get yours at: https://openweathermap.org/api
# Leave empty to use stored/demo readings instead of live data
OPENWEATHER_API_KEY=

# Groq API Key (for AI features)
# Get yours at: https://console.groq.com
# Leave empty to use the offline rule-based Copilot
GROQ_API_KEY=
# Must be a model your Groq account can access (see console.groq.com/docs/models)
# GROQ_MODEL=qwen/qwen3-32b

# -------------------------------------------
# Application Settings
# -------------------------------------------
# development | production  (production refuses to start without SECRET_KEY and skips demo users)
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------
# Set in frontend/.env.local, not here (Vite only reads env files from frontend/)
# VITE_API_URL=http://localhost:8000
